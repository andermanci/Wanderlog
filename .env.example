# ============================================================
# WANDERLOG - Variables de entorno
# ============================================================
# Copia este archivo como .env y rellena tus valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- Supabase ---
# URL del proyecto Supabase (Settings > API > Project URL)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave anon pública de Supabase (Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=eyJ...

# --- Google Maps ---
# API Key con los siguientes servicios activados:
#   · Maps JavaScript API
#   · Places API
#   · Directions API (para el recorrido en el mapa)
# Crea la key en: https://console.cloud.google.com/apis/credentials
# Restricción recomendada: HTTP referrers → http://localhost:5173/* y tu dominio
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...

# --- Opcionales (solo para Edge Functions) ---
# Clave service-role de Supabase (SECRETO - nunca expongas esto al frontend)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Configuración SMTP para correos (a través de Supabase Edge Functions)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@gmail.com
# SMTP_PASS=app_password_aqui

# Clave pública VAPID para notificaciones push (no secreta). Opcional: hay
# un valor por defecto en el código. La privada va como secret de Supabase.
VITE_VAPID_PUBLIC_KEY=
